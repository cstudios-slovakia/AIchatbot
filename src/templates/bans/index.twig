{% extends 'interactive-ai-assistant/_layout' %}
{% set title = 'Bans' %}
{% set selectedSubnavItem = 'logs-bans' %}
{% set tabs = {
  logs: { label: 'Chat Logs', url: url('interactive-ai-assistant/logs') },
  bans: { label: 'Bans', url: url('interactive-ai-assistant/bans') },
} %}
{% set selectedTab = 'bans' %}

{% block content %}
  <div style="display:flex; gap:32px; align-items:flex-start;">
    <div style="flex:2;">
      <h2 style="margin-top:0;">Active bans</h2>
      {% if not bans|length %}
        <p>No active bans.</p>
      {% else %}
        <table class="data fullwidth">
          <thead>
            <tr><th>IP</th><th>Reason</th><th>Banned by</th><th>Banned at</th><th>Expires</th><th></th></tr>
          </thead>
          <tbody>
            {% for b in bans %}
              <tr data-ban-id="{{ b.id }}">
                <td><code>{{ b.ip }}</code></td>
                <td>{{ b.reason ?: '—' }}</td>
                <td>{{ b.bannedByName ?: '—' }}</td>
                <td>{{ b.dateCreated ? b.dateCreated|date('Y-m-d H:i') : '' }}</td>
                <td>{{ b.expiresAt ? b.expiresAt|date('Y-m-d H:i') : 'Permanent' }}</td>
                <td><button type="button" class="btn small unban-btn" data-id="{{ b.id }}">Unban</button></td>
              </tr>
            {% endfor %}
          </tbody>
        </table>
      {% endif %}
    </div>

    <div style="flex:1; max-width:340px;">
      <h2 style="margin-top:0;">Add ban</h2>
      <form method="post" accept-charset="UTF-8">
        {{ csrfInput() }}
        {{ actionInput('interactive-ai-assistant/bans/create') }}
        <div class="field">
          <label>IP address</label>
          <input type="text" name="ip" class="text fullwidth" placeholder="1.2.3.4" required>
        </div>
        <div class="field">
          <label>Duration</label>
          <select name="duration" class="fullwidth">
            <option value="1h">1 hour</option>
            <option value="24h">24 hours</option>
            <option value="7d">7 days</option>
            <option value="30d">30 days</option>
            <option value="forever" selected>Permanent</option>
          </select>
        </div>
        <div class="field">
          <label>Reason (optional)</label>
          <input type="text" name="reason" class="text fullwidth" maxlength="500">
        </div>
        <button type="submit" class="btn submit">Ban</button>
      </form>
    </div>
  </div>

  {% js %}
    document.querySelectorAll('.unban-btn').forEach(function (b) {
      b.addEventListener('click', function () {
        if (!confirm('Remove this ban?')) return;
        var fd = new FormData();
        fd.append('id', b.dataset.id);
        fd.append(window.Craft.csrfTokenName, window.Craft.csrfTokenValue);
        fetch('{{ actionUrl('interactive-ai-assistant/bans/delete')|e('js') }}', { method:'POST', body: fd, credentials:'same-origin', headers:{'Accept':'application/json','X-Requested-With':'XMLHttpRequest'} })
          .then(function (r) { return r.json(); })
          .then(function (r) {
            if (r.success) {
              var row = document.querySelector('tr[data-ban-id="' + b.dataset.id + '"]');
              if (row) row.remove();
            }
          });
      });
    });
  {% endjs %}
{% endblock %}
