{% extends 'interactive-ai-assistant/_layout' %}
{% set title = 'Bans' %}
{% set selectedSubnavItem = 'logs-bans' %}
{% set tabs = {
  logs: { label: 'Chat Logs', url: url('interactive-ai-assistant/logs') },
  bans: { label: 'Bans', url: url('interactive-ai-assistant/logs/bans') },
} %}
{% set selectedTab = 'bans' %}

{% import 'interactive-ai-assistant/_icons' as icons %}

{% block content %}
  <div class="iaa-cards">
    <div class="iaa-card iaa-card--bans">
      <div class="iaa-card__head">
        <span class="iaa-card__icon">{{ icons.svg('ban') }}</span>
        <h2 class="iaa-card__title">Active bans</h2>
        {% if bans|length %}<span class="iaa-card__aside"><span class="iaa-chip">{{ bans|length }}</span></span>{% endif %}
      </div>
      {% if not bans|length %}
        <div class="iaa-empty"><p>No active bans.</p></div>
      {% else %}
        <div class="iaa-card__body iaa-card__body--flush iaa-scroll">
          <table class="data fullwidth">
            <thead>
              <tr><th>IP</th><th>Reason</th><th>Banned by</th><th>Banned at</th><th>Expires</th><th></th></tr>
            </thead>
            <tbody>
              {% for b in bans %}
                <tr data-ban-id="{{ b.id }}">
                  <td><code>{{ b.ip }}</code></td>
                  <td>{{ b.reason ?: '—' }}</td>
                  <td>{{ b.bannedByName ?: '—' }}</td>
                  <td class="iaa-nowrap">{{ b.dateCreated ? b.dateCreated|date('Y-m-d H:i') : '' }}</td>
                  <td class="iaa-nowrap">{% if b.expiresAt %}{{ b.expiresAt|date('Y-m-d H:i') }}{% else %}<span class="iaa-chip iaa-chip--bad">Permanent</span>{% endif %}</td>
                  <td class="iaa-nowrap"><div class="iaa-row-actions"><button type="button" class="btn small unban-btn" data-id="{{ b.id }}">Unban</button></div></td>
                </tr>
              {% endfor %}
            </tbody>
          </table>
        </div>
      {% endif %}
    </div>

    <div class="iaa-card iaa-card--side">
      <div class="iaa-card__head">
        <span class="iaa-card__icon">{{ icons.svg('shield-halved') }}</span>
        <h2 class="iaa-card__title">Add ban</h2>
      </div>
      <form method="post" accept-charset="UTF-8">
        {{ csrfInput() }}
        {{ actionInput('interactive-ai-assistant/bans/create') }}
        <div class="iaa-card__body">
          <div class="field">
            <div class="heading"><label for="iaa-ban-ip">IP address</label></div>
            <div class="input"><input type="text" id="iaa-ban-ip" name="ip" class="text fullwidth" placeholder="1.2.3.4" required></div>
          </div>
          <div class="field">
            <div class="heading"><label for="iaa-ban-duration">Duration</label></div>
            <div class="input">
              <div class="select fullwidth">
                <select id="iaa-ban-duration" name="duration" class="fullwidth">
                  <option value="1h">1 hour</option>
                  <option value="24h">24 hours</option>
                  <option value="7d">7 days</option>
                  <option value="30d">30 days</option>
                  <option value="forever" selected>Permanent</option>
                </select>
              </div>
            </div>
          </div>
          <div class="field">
            <div class="heading"><label for="iaa-ban-reason">Reason (optional)</label></div>
            <div class="input"><input type="text" id="iaa-ban-reason" name="reason" class="text fullwidth" maxlength="500"></div>
          </div>
        </div>
        <div class="iaa-card__foot">
          <button type="submit" class="btn submit">Ban</button>
        </div>
      </form>
    </div>
  </div>

  {% js %}
    document.querySelectorAll('.unban-btn').forEach(function (b) {
      b.addEventListener('click', function () {
        if (!confirm('Remove this ban?')) return;
        var fd = new FormData();
        fd.append('id', b.dataset.id);
        fd.append(window.Craft.csrfTokenName, window.Craft.csrfTokenValue);
        fetch('{{ actionUrl('interactive-ai-assistant/bans/delete')|e('js') }}', { method:'POST', body: fd, credentials:'same-origin', headers:{'Accept':'application/json','X-Requested-With':'XMLHttpRequest'} })
          .then(function (r) { return r.json(); })
          .then(function (r) {
            if (r.success) {
              var row = document.querySelector('tr[data-ban-id="' + b.dataset.id + '"]');
              if (row) row.remove();
            }
          });
      });
    });
  {% endjs %}
{% endblock %}
