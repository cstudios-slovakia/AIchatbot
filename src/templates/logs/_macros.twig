{% macro confidenceBadge(score) %}
  {% if score is null %}
    <span class="iaa-chip">—</span>
  {% else %}
    {% set pct = (score * 100)|round %}
    {% if pct >= 80 %}{% set tone = 'good' %}
    {% elseif pct >= 60 %}{% set tone = 'warn' %}
    {% else %}{% set tone = 'bad' %}{% endif %}
    <span class="iaa-chip iaa-chip--{{ tone }}">{{ pct }}%</span>
  {% endif %}
{% endmacro %}
