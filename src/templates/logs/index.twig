{% extends 'interactive-ai-assistant/_layout' %}
{% set title = 'Chat Logs' %}
{% set selectedSubnavItem = 'logs-bans' %}
{% set tabs = {
  logs: { label: 'Chat Logs', url: url('interactive-ai-assistant/logs') },
  bans: { label: 'Bans', url: url('interactive-ai-assistant/logs/bans') },
} %}
{% set selectedTab = 'logs' %}
{% import 'interactive-ai-assistant/logs/_macros' as m %}

{% import 'interactive-ai-assistant/_icons' as icons %}

{% block content %}
  <form method="get" class="iaa-filters">
    <div class="field">
      <div class="texticon search icon clearable">
        <span class="texticon-icon search icon" aria-hidden="true"></span>
        <input type="search" name="q" value="{{ q }}" placeholder="Short ID / token / text" class="text fullwidth" autocomplete="off" aria-label="Short ID / token / text">
      </div>
    </div>
    <div class="field field--narrow">
      <div class="select">
        <select name="rating" aria-label="All ratings">
          <option value="">All ratings</option>
          <option value="pos" {{ rating == 'pos' ? 'selected' }}>Positive</option>
          <option value="neg" {{ rating == 'neg' ? 'selected' }}>Negative</option>
        </select>
      </div>
    </div>
    <div class="field field--narrow">
      <div class="select">
        <select name="confidence" aria-label="All confidence">
          <option value="">All confidence</option>
          <option value="high" {{ confidence == 'high' ? 'selected' }}>High (&ge; 80%)</option>
          <option value="mid"  {{ confidence == 'mid'  ? 'selected' }}>Medium (60-79%)</option>
          <option value="low"  {{ confidence == 'low'  ? 'selected' }}>Low (&lt; 60%)</option>
          <option value="none" {{ confidence == 'none' ? 'selected' }}>No context</option>
        </select>
      </div>
    </div>
    <label class="iaa-filters__check">
      <input type="checkbox" name="starred" value="1" {{ starredOnly ? 'checked' }}> ★ Favourites only
    </label>
    <label class="iaa-filters__check">
      <input type="checkbox" name="active" value="1" {{ activeOnly ? 'checked' }}> 🟢 Active now
    </label>
    <div class="iaa-go">
      <button class="btn submit" type="submit">Filter</button>
      {% if q or rating or confidence or starredOnly or activeOnly %}
        <a class="btn" href="{{ url('interactive-ai-assistant/logs') }}">Clear</a>
      {% endif %}
    </div>
  </form>

  <div class="iaa-cards">
    <div class="iaa-card iaa-card--wide">
      <div class="iaa-card__head">
        <span class="iaa-card__icon">{{ icons.svg('comments') }}</span>
        <h2 class="iaa-card__title">{{ total }} sessions total</h2>
      </div>
      {% if rows|length %}
        <div class="iaa-card__body iaa-card__body--flush iaa-scroll">
          <table class="data fullwidth iaa-fixed iaa-logs-table">
            <colgroup>
              <col class="iaa-col-star">
              <col class="iaa-col-session">
              <col class="iaa-col-page">
              <col class="iaa-col-msgs">
              <col class="iaa-col-rating">
              <col class="iaa-col-conf">
              <col class="iaa-col-ip">
              <col class="iaa-col-started">
            </colgroup>
            <thead>
              <tr>
                <th scope="col">★</th>
                <th scope="col">Session</th>
                <th scope="col">Page</th>
                <th scope="col" class="iaa-num">Msgs</th>
                <th scope="col">Rating</th>
                <th scope="col">Confidence</th>
                <th scope="col">IP</th>
                <th scope="col">Started</th>
              </tr>
            </thead>
            <tbody>
              {% for r in rows %}
                <tr data-session-id="{{ r.id }}">
                  <td>
                    <button type="button" class="logs-star-btn iaa-star{{ r.starred ? ' is-on' }}" data-id="{{ r.id }}" title="{{ r.starred ? 'Unfavourite' : 'Favourite' }}">
                      {{ r.starred ? '★' : '☆' }}
                    </button>
                  </td>
                  <td class="iaa-clip">
                    <a href="{{ url('interactive-ai-assistant/logs/session/' ~ r.id) }}" class="code">
                      {{ '%05d-%s'|format(r.id, r.sessionToken|slice(0, 4)|upper) }}
                    </a>
                    {% if r.adminNotes %}
                      <span class="iaa-note-mark" title="{{ r.adminNotes|slice(0, 200) }}">📝</span>
                    {% endif %}
                  </td>
                  <td class="iaa-clip" title="{{ r.pageUrl }}">
                    {{ r.pageUrl ?: '—' }}
                  </td>
                  <td class="iaa-num">{{ r.messageCount }}</td>
                  <td class="iaa-nowrap">
                    <span class="iaa-up">{{ r.ratingPositive }} &uarr;</span>
                    &nbsp;
                    <span class="iaa-down">{{ r.ratingNegative }} &darr;</span>
                    {% if r.chatRating == 1 %} <span title="End-of-chat rating">👍</span>
                    {% elseif r.chatRating == -1 %} <span title="End-of-chat rating">👎</span>
                    {% endif %}
                  </td>
                  <td>{{ m.confidenceBadge(r.maxConf) }}</td>
                  <td class="iaa-clip">{{ r.ip ?: '—' }}</td>
                  <td class="iaa-nowrap">
                    {{ r.dateCreated|datetime('short') }}
                    {% if not r.chatEndedAt %}<span class="iaa-live" title="Not yet ended">● live</span>{% endif %}
                  </td>
                </tr>
              {% endfor %}
            </tbody>
          </table>
        </div>
      {% else %}
        <div class="iaa-empty"><p>No sessions found.</p></div>
      {% endif %}
    </div>
  </div>

  {% if rows|length %}
    <div class="iaa-pages">
      {% if page > 1 %}
        <a class="btn" href="?{{ {q:q, rating:rating, confidence:confidence, starred:starredOnly?1:'', active:activeOnly?1:'', page:page-1}|url_encode }}">&larr; Prev</a>
      {% endif %}
      <span class="light">Page {{ page }} &middot; {{ total }} sessions total</span>
      {% if rows|length == perPage %}
        <a class="btn" href="?{{ {q:q, rating:rating, confidence:confidence, starred:starredOnly?1:'', active:activeOnly?1:'', page:page+1}|url_encode }}">Next &rarr;</a>
      {% endif %}
    </div>
  {% endif %}

  {% js %}
    document.querySelectorAll('.logs-star-btn').forEach(function (b) {
      b.addEventListener('click', function () {
        var fd = new FormData();
        fd.append(window.Craft.csrfTokenName, window.Craft.csrfTokenValue);
        fd.append('id', b.dataset.id);
        fetch('{{ actionUrl('interactive-ai-assistant/logs/toggle-star')|e('js') }}', { method:'POST', body: fd, credentials:'same-origin', headers:{'Accept':'application/json','X-Requested-With':'XMLHttpRequest'} })
          .then(function(r){ return r.json(); })
          .then(function(r){
            if (!r.success) return;
            b.textContent = r.starred ? '★' : '☆';
            b.classList.toggle('is-on', !!r.starred);
            b.title = r.starred ? 'Unfavourite' : 'Favourite';
          });
      });
    });
  {% endjs %}
{% endblock %}
