{% extends 'interactive-ai-assistant/_layout' %}
{% set title = 'Session ' ~ session.sessionToken|slice(0, 10) %}
{% set selectedSubnavItem = 'logs-bans' %}
{% import 'interactive-ai-assistant/logs/_macros' as m %}
{% import 'interactive-ai-assistant/_icons' as icons %}

{% block content %}
  <p><a class="btn" href="{{ url('interactive-ai-assistant/logs') }}">&larr; Back to logs</a></p>

  <div class="iaa-log">
    <div class="iaa-log__chat">
      <div class="iaa-card">
        <div class="iaa-card__head">
          <span class="iaa-card__icon">{{ icons.svg('comments') }}</span>
          <h2 class="iaa-card__title">Conversation</h2>
        </div>
        <div class="iaa-log__messages">
          {% for msg in messages %}
            <div class="iaa-msg {{ msg.role == 'bot' ? 'iaa-msg--bot' : 'iaa-msg--user' }}">
              <div class="iaa-msg__head">
                <strong>{{ msg.role == 'bot' ? 'Bot' : 'User' }}</strong>
                <span class="light">{{ msg.dateCreated|datetime('short') }}</span>
                {% if msg.responseTime %}<span class="light">{{ msg.responseTime }}s</span>{% endif %}
                {% if msg.role == 'bot' %}{{ m.confidenceBadge(msg.confidence) }}{% endif %}
                {% if msg.rating == 1 %}<span class="iaa-up">&uarr;</span>{% endif %}
                {% if msg.rating == -1 %}<span class="iaa-down">&darr;</span>{% endif %}
                {% if msg.usedAsQa %}
                  <span class="iaa-chip iaa-chip--good">&check; Q&amp;A Training</span>
                {% endif %}
                {% if msg.role == 'bot' and not msg.usedAsQa %}
                  <button class="btn small js-use-qa iaa-msg__action" data-id="{{ msg.id }}">Use as Q&amp;A</button>
                {% endif %}
              </div>
              <div class="cs-md">{{ msg.content|md('gfm-comment') }}</div>
            </div>
          {% endfor %}
        </div>
      </div>
    </div>

    <aside class="iaa-log__meta">
      <div class="iaa-card">
        <div class="iaa-card__head">
          <span class="iaa-card__icon">{{ icons.svg('circle-info') }}</span>
          <h2 class="iaa-card__title">Session</h2>
        </div>
        <div class="iaa-card__body">
          <dl class="iaa-facts iaa-facts--stack">
            <div class="iaa-fact">
              <dt class="iaa-fact__label">Session</dt>
              <dd class="iaa-fact__value iaa-code">{{ session.sessionToken }}</dd>
            </div>
            <div class="iaa-fact">
              <dt class="iaa-fact__label">Page</dt>
              <dd class="iaa-fact__value">{{ session.pageUrl ?: '—' }}</dd>
            </div>
            <div class="iaa-fact">
              <dt class="iaa-fact__label">IP</dt>
              <dd class="iaa-fact__value">{{ session.ip ?: '—' }}</dd>
            </div>
            <div class="iaa-fact">
              <dt class="iaa-fact__label">Started</dt>
              <dd class="iaa-fact__value">{{ session.dateCreated|datetime('short') }}</dd>
            </div>
            <div class="iaa-fact">
              <dt class="iaa-fact__label">Ratings</dt>
              <dd class="iaa-fact__value">
                <span class="iaa-up">{{ session.ratingPositive }} &uarr;</span>
                &nbsp;
                <span class="iaa-down">{{ session.ratingNegative }} &darr;</span>
              </dd>
            </div>
          </dl>
        </div>
      </div>

      <div class="iaa-card iaa-card--warn">
        <div class="iaa-card__head">
          <span class="iaa-card__icon">{{ icons.svg('pen') }}</span>
          <h2 class="iaa-card__title">Admin notes</h2>
          <span class="iaa-card__aside"><span id="lc-note-status" class="light"></span></span>
        </div>
        <div class="iaa-card__body">
          <p class="iaa-card__note">(searchable from logs page)</p>
          <textarea id="lc-note" class="text fullwidth" rows="5" placeholder="Notes for this conversation — e.g. context, follow-up, internal tags...">{{ session.adminNotes }}</textarea>
        </div>
        <div class="iaa-card__foot">
          <button type="button" class="btn submit" id="lc-note-save">Save note</button>
        </div>
      </div>
    </aside>
  </div>

  <script>
    (function(){
      var $note = document.getElementById('lc-note');
      var $save = document.getElementById('lc-note-save');
      var $status = document.getElementById('lc-note-status');
      var saveTimer = null;
      function saveNote() {
        var fd = new FormData();
        fd.append(Craft.csrfTokenName, Craft.csrfTokenValue);
        fd.append('id', '{{ session.id }}');
        fd.append('note', $note.value);
        $status.textContent = 'Saving…';
        fetch(Craft.getActionUrl('interactive-ai-assistant/logs/save-note'), {method:'POST', body:fd, credentials:'same-origin', headers:{'Accept':'application/json','X-Requested-With':'XMLHttpRequest'}})
          .then(function(r){return r.json();})
          .then(function(r){ $status.textContent = r.success ? 'Saved ✓' : 'Save failed'; setTimeout(function(){$status.textContent='';}, 2000); });
      }
      $save.addEventListener('click', saveNote);
      $note.addEventListener('input', function () {
        if (saveTimer) clearTimeout(saveTimer);
        saveTimer = setTimeout(saveNote, 1200);
      });
      $note.addEventListener('keydown', function (e) {
        if ((e.metaKey || e.ctrlKey) && (e.key === 's' || e.key === 'S')) {
          e.preventDefault();
          if (saveTimer) clearTimeout(saveTimer);
          saveNote();
        }
      });

      document.querySelectorAll('.cs-md a[href]').forEach(function (a) {
        var href = a.getAttribute('href') || '';
        if (!/^(https?:|mailto:)/i.test(href)) {
          a.removeAttribute('href');
          return;
        }
        if (!a.getAttribute('title')) a.setAttribute('title', href);
        if (!a.getAttribute('data-cs-href')) a.setAttribute('data-cs-href', href);
        a.setAttribute('target', '_blank');
        a.setAttribute('rel', 'noopener nofollow');
      });

      document.querySelectorAll('.js-use-qa').forEach(function(b){
        b.addEventListener('click', function(){
          var data = new FormData();
          data.append(Craft.csrfTokenName, Craft.csrfTokenValue);
          data.append('messageId', b.dataset.id);
          fetch(Craft.getActionUrl('interactive-ai-assistant/logs/use-as-qa'), {method:'POST', body:data, credentials:'same-origin'})
            .then(function(r){return r.json();})
            .then(function(j){ if (j.success){ location.reload(); } else { alert(j.error || 'Failed'); } });
        });
      });
    })();
  </script>
{% endblock %}
