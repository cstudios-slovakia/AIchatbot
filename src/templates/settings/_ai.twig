{% import '_includes/forms' as forms %}

{{ forms.autosuggestField({
  label: 'OpenAI API Key',
  instructions: 'Required for embeddings and chat completions. Supports $ENV_VAR.',
  name: 'settings[openaiApiKey]',
  value: settings.openaiApiKey,
  suggestEnvVars: true,
}) }}

{{ forms.selectField({
  label: 'Chat Model',
  instructions: 'GPT-5 reasoning models (gpt-5, gpt-5-mini, gpt-5-nano) run at default temperature. gpt-5-chat-latest and GPT-4o honor the configured temperature.',
  name: 'settings[chatModel]',
  value: settings.chatModel,
  options: {
    'gpt-5': 'gpt-5',
    'gpt-5-mini': 'gpt-5-mini (recommended)',
    'gpt-5-nano': 'gpt-5-nano (fastest / cheapest)',
    'gpt-5-chat-latest': 'gpt-5-chat-latest',
    'gpt-4o-mini': 'gpt-4o-mini',
    'gpt-4o': 'gpt-4o',
    'gpt-3.5-turbo': 'gpt-3.5-turbo',
  },
}) }}

{{ forms.selectField({
  label: 'Embedding Model',
  instructions: 'Switching this requires full retraining of all content.',
  name: 'settings[embeddingModel]',
  value: settings.embeddingModel,
  options: {
    'text-embedding-3-small': 'text-embedding-3-small (recommended)',
    'text-embedding-3-large': 'text-embedding-3-large',
    'text-embedding-ada-002': 'text-embedding-ada-002',
  },
}) }}

{{ forms.textField({
  label: 'Initial Message (default)',
  instructions: 'Opening message shown when chat starts. Used when no site-specific override is set below.',
  name: 'settings[initialMessage]',
  value: settings.initialMessage,
}) }}

{{ forms.textareaField({
  label: 'System Prompt (default)',
  name: 'settings[systemPrompt]',
  value: settings.systemPrompt,
  rows: 6,
}) }}

{% set allSites = craft.app.sites.getAllSites() %}
{% if allSites|length > 1 %}
  <hr>
  <h2>Per-site translations / overrides</h2>
  <p class="light">Leave a field blank to fall back to the matching default. Each Craft site can have its own opener, company name, suggestions and system prompt.</p>

  {% for site in allSites %}
    <div style="border:1px solid #d8dde2;border-radius:6px;padding:14px;margin-bottom:14px;background:#fbfcfd;">
      <div style="font-weight:600;font-size:14px;margin-bottom:8px;">
        {{ site.name }}
        <span class="light" style="font-weight:normal;font-size:11px;">· {{ site.handle }} · {{ site.language }} · {{ site.baseUrl ?: '—' }}</span>
      </div>

      {{ forms.textField({
        label: 'Company Name',
        name: 'settings[companyNames][' ~ site.uid ~ ']',
        value: settings.companyNames[site.uid] ?? '',
        placeholder: settings.companyName,
      }) }}

      {{ forms.textField({
        label: 'Initial Message',
        name: 'settings[initialMessages][' ~ site.uid ~ ']',
        value: settings.initialMessages[site.uid] ?? '',
        placeholder: settings.initialMessage,
      }) }}

      {{ forms.textareaField({
        label: 'System Prompt',
        name: 'settings[systemPrompts][' ~ site.uid ~ ']',
        value: settings.systemPrompts[site.uid] ?? '',
        placeholder: settings.systemPrompt,
        rows: 4,
      }) }}
    </div>
  {% endfor %}
{% endif %}

{{ forms.textField({
  label: 'Max Context Chunks',
  name: 'settings[maxContextChunks]',
  value: settings.maxContextChunks,
  type: 'number',
  size: 6,
}) }}

{{ forms.textField({
  label: 'Min Similarity Score',
  instructions: '0.00 to 1.00',
  name: 'settings[minSimilarityScore]',
  value: settings.minSimilarityScore,
  type: 'number',
  step: '0.01',
  min: 0,
  max: 1,
  size: 6,
}) }}

<hr>
<h2>Agent &amp; skills</h2>

{{ forms.lightswitchField({
  label: 'Enable agent mode (skills)',
  instructions: 'When on, the assistant can call registered "skills" (tools) to fetch live data or perform actions, in addition to answering from trained content. When off, it is pure retrieval Q&A.',
  name: 'settings[agentModeEnabled]',
  on: settings.agentModeEnabled,
}) }}

{{ forms.textField({
  label: 'Max tool iterations',
  instructions: 'Safety cap on how many tool-call rounds a single answer may take (1–10).',
  name: 'settings[maxToolIterations]',
  value: settings.maxToolIterations,
  type: 'number',
  size: 4,
  min: 1,
  max: 10,
}) }}

{{ forms.lightswitchField({
  label: 'Enable conversational forms',
  instructions: 'Lets the assistant collect and submit admin-defined forms (e.g. lead/quote requests) to a webhook/CRM or email. Adds the Forms and Submissions screens. Requires agent mode. Off by default.',
  name: 'settings[formsEnabled]',
  on: settings.formsEnabled ?? false,
}) }}

{% if settings.formsEnabled %}
  <p class="light" style="margin-top:-8px;">Manage forms under <a href="{{ url('interactive-ai-assistant/forms') }}">Forms</a>; review captures under <a href="{{ url('interactive-ai-assistant/missed-chats/submissions') }}">Submissions</a>.</p>
{% endif %}

{% if settings.agentModeEnabled %}
  {% set formNames = [] %}
  {% if settings.formsEnabled %}
    {% for f in settings.formDefinitions() %}{% set formNames = formNames|merge([f.name]) %}{% endfor %}
  {% endif %}
  <h3>Registered skills</h3>
  {% if capabilities|length %}
    <p class="light">Choose where each skill is available. <strong>Admins only</strong> exposes it just to logged-in control-panel users — handy for testing on the live site before turning it on for everyone.</p>
    <table class="data fullwidth">
      <thead>
        <tr><th scope="col">Skill</th><th scope="col">Description</th><th scope="col" style="width:180px;">Availability</th></tr>
      </thead>
      <tbody>
        {% for cap in capabilities %}
          <tr>
            <td>
              {% if cap.name() in formNames %}
                <a href="{{ url('interactive-ai-assistant/forms/edit/' ~ cap.name()) }}" title="Edit this form"><code>{{ cap.name() }}</code></a>
              {% else %}
                <code>{{ cap.name() }}</code>
              {% endif %}
            </td>
            <td class="light">{{ cap.description() }}</td>
            <td>
              {{ forms.select({
                name: 'settings[capabilityStates][' ~ cap.name() ~ ']',
                value: settings.capabilityState(cap.name()),
                options: {
                  off: 'Off',
                  on: 'Enabled (everyone)',
                  admins: 'Admins only (testing)',
                },
              }) }}
            </td>
          </tr>
        {% endfor %}
      </tbody>
    </table>
  {% else %}
    <p class="light">No skills are registered yet. Plugins or modules add them via the <code>Capabilities::EVENT_REGISTER_CAPABILITIES</code> event.</p>
  {% endif %}
{% endif %}
