{% import '_includes/forms' as forms %}
{% import 'interactive-ai-assistant/_icons' as icons %}

<div class="iaa-cards">
  <div class="iaa-card iaa-card--wide">
    <div class="iaa-card__head">
      <span class="iaa-card__icon">{{ icons.svg('filter') }}</span>
      <h2 class="iaa-card__title">Message filter</h2>
    </div>
    <div class="iaa-card__body">
      <div class="iaa-rows">
        {{ forms.lightswitchField({
          label: 'Enable filter',
          instructions: 'Blocks empty, too-long, gibberish, and rate-limited messages before they reach the AI. Runs on both frontend and backend.',
          name: 'settings[filterEnabled]',
          on: settings.filterEnabled,
        }) }}

        {{ forms.textField({
          label: 'Minimum message length',
          instructions: 'Messages shorter than this (after trimming) are rejected.',
          name: 'settings[filterMinLength]',
          value: settings.filterMinLength,
          type: 'number',
          size: 6,
        }) }}

        {{ forms.textField({
          label: 'Maximum message length',
          instructions: 'Hard cap on message length in characters.',
          name: 'settings[filterMaxLength]',
          value: settings.filterMaxLength,
          type: 'number',
          size: 6,
        }) }}
      </div>
    </div>
  </div>
  <div class="iaa-card iaa-card--wide">
    <div class="iaa-card__head">
      <span class="iaa-card__icon">{{ icons.svg('gauge') }}</span>
      <h2 class="iaa-card__title">Rate limit</h2>
    </div>
    <div class="iaa-card__body">
      <div class="iaa-rows">
        {{ forms.textField({
          label: 'Window (seconds)',
          instructions: 'Time window for counting messages. Set 0 to disable rate limiting.',
          name: 'settings[filterRateWindowSeconds]',
          value: settings.filterRateWindowSeconds,
          type: 'number',
          size: 6,
        }) }}

        {{ forms.textField({
          label: 'Max messages per session in window',
          instructions: 'Per-session cap. IP cap is 3× this value across all sessions.',
          name: 'settings[filterRateMaxMessages]',
          value: settings.filterRateMaxMessages,
          type: 'number',
          size: 6,
        }) }}
      </div>
    </div>
  </div>
  <div class="iaa-card iaa-card--wide">
    <div class="iaa-card__head">
      <span class="iaa-card__icon">{{ icons.svg('ban') }}</span>
      <h2 class="iaa-card__title">Blocked words / phrases</h2>
    </div>
    <div class="iaa-card__body">
      {{ forms.textareaField({
        label: 'Blocked words / phrases',
        instructions: 'One per line. Case-insensitive substring match. Empty to disable.',
        name: 'settings[filterBlockedWords]',
        value: settings.filterBlockedWords|join("\n"),
        rows: 8,
      }) }}
    </div>
  </div>
</div>
