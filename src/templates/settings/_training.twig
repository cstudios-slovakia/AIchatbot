{% import '_includes/forms' as forms %}
{% import 'interactive-ai-assistant/_icons' as icons %}

<div class="iaa-cards">
  <div class="iaa-card iaa-card--wide">
    <div class="iaa-card__head">
      <span class="iaa-card__icon">{{ icons.svg('database') }}</span>
      <h2 class="iaa-card__title">What to train</h2>
    </div>
    <div class="iaa-card__body">
      <div class="iaa-checkgrid">
        {{ forms.checkboxSelectField({
          label: 'Sections to train',
          name: 'settings[trainingSections]',
          values: settings.trainingSections,
          options: sections|map(s => { label: s.name, value: s.uid }),
          showAllOption: false,
        }) }}

        {{ forms.checkboxSelectField({
          label: 'Category groups to train',
          name: 'settings[trainingCategoryGroups]',
          values: settings.trainingCategoryGroups,
          options: categoryGroups|map(g => { label: g.name, value: g.uid }),
          showAllOption: false,
        }) }}

        {{ forms.checkboxSelectField({
          label: 'Global sets to train',
          name: 'settings[trainingGlobalSets]',
          values: settings.trainingGlobalSets,
          options: globalSets|map(g => { label: g.name, value: g.uid }),
          showAllOption: false,
        }) }}
      </div>

      <div class="iaa-rows">
        {{ forms.lightswitchField({
          label: 'Auto-Train on Save',
          instructions: 'Automatically index entries, categories and globals whenever they are saved (background job). Only items in selected sections / groups / sets are auto-trained.',
          name: 'settings[autoTrainOnSave]',
          on: settings.autoTrainOnSave,
        }) }}
      </div>
    </div>
  </div>
  <div class="iaa-card iaa-card--wide">
    <div class="iaa-card__head">
      <span class="iaa-card__icon">{{ icons.svg('file-lines') }}</span>
      <h2 class="iaa-card__title">Index from the rendered page</h2>
    </div>
    <div class="iaa-card__body">
      <div class="iaa-card__note">
        <p>
          Checked sections are indexed by fetching each entry's own URL, not by reading its fields. Use
          this on older sites where much of what a visitor reads is printed by the template and never
          reaches a field — security classes, dimensions, standards. Fetching gets exactly what the
          visitor gets, in the right language per site. Field values are left out in this mode because the
          template already printed them; indexing both would store the same sentence twice.
        </p>
        <p>
          Costs an HTTP request per entry, so indexing takes longer. If a page can't be fetched, that
          entry falls back to its fields rather than dropping out of the index.
        </p>
      </div>

      <div class="iaa-checkgrid">
        {{ forms.checkboxSelectField({
          label: 'Sections to index from their page',
          name: 'settings[pageRenderSections]',
          values: settings.pageRenderSections,
          options: sections|map(s => { label: s.name, value: s.uid }),
          showAllOption: false,
          instructions: 'Only sections whose entries have URLs. Sections listed here must also be selected above.',
        }) }}
      </div>

      {{ forms.textField({
        label: 'Content selector',
        name: 'settings[contentSelector]',
        value: settings.contentSelector,
        placeholder: 'main',
        instructions: 'CSS selector for the readable part of a page — `main`, `#content`, `article.post`. Comma-separated, first match wins. Leave empty to try <main>, [role=main], <article>, #content, #main, then the whole body. Setting this is the single biggest thing you can do for page-mode quality.',
      }) }}

      <div class="iaa-rows">
        {{ forms.lightswitchField({
          label: 'Strip page chrome',
          name: 'settings[stripPageChrome]',
          on: settings.stripPageChrome,
          instructions: 'Remove nav, header, footer, cookie bars and similar from fetched pages. Chrome repeats on every page, so left in it becomes the most common text in the index and matches every question a little. Skipped inside an explicit content selector, and automatically undone if it would empty the page.',
        }) }}
      </div>
    </div>
  </div>
  <div class="iaa-card iaa-card--wide">
    <div class="iaa-card__head">
      <span class="iaa-card__icon">{{ icons.svg('ban') }}</span>
      <h2 class="iaa-card__title">Fields to keep out of the index</h2>
    </div>
    <div class="iaa-card__body">
      <p class="iaa-card__note">
        Checked fields are skipped when content is indexed. They stay untouched on the site — this only
        controls what the assistant can read. Use it for values that are real but incomplete: a price
        only some entries carry makes the assistant quote a figure for one product and nothing for the
        next, which reads as inconsistency rather than as a gap. <strong>Retrain the affected sources
        after changing this</strong> — existing chunks keep whatever they were built with.
      </p>

      <div class="iaa-scopes">
        {% for scope in excludeScopes %}
          {% set chosen = settings.excludedFields[scope.uid] ?? [] %}
          <details class="iaa-scope iaa-disclosure"{% if chosen|length %} open{% endif %}>
            <summary>
              {{ scope.label }}
              {% if chosen|length %}<span class="iaa-chip iaa-chip--warn">{{ chosen|length }} excluded</span>{% endif %}
            </summary>
            <div class="iaa-scope__body">
              {{ forms.checkboxSelect({
                      name: 'settings[excludedFields][' ~ scope.uid ~ ']',
                      values: chosen,
                      options: scope.options,
                      showAllOption: false,
                    }) }}
            </div>
          </details>
        {% endfor %}
      </div>
    </div>
  </div>
</div>
