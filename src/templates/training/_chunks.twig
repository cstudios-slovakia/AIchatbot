{% extends '_cs-chatbot/_layout' %}
{% set title = subtitle ~ ': ' ~ title %}
{% set selectedSubnavItem = 'training' %}

{% block content %}
  <p><a class="btn" href="{{ url(backUrl) }}">← Back</a></p>
  <h2>{{ title }}</h2>
  <p class="light">{{ chunks|length }} chunks</p>
  {% for c in chunks %}
    <div class="readable" style="padding:12px;border:1px solid #d8dde2;border-radius:6px;background:#fff;margin-bottom:8px;">
      <div style="font-size:12px;color:#596673;">#{{ c.position }} · {{ c.tokens }} tokens</div>
      <pre style="white-space:pre-wrap;margin:8px 0 0;font-family:inherit;">{{ c.content }}</pre>
    </div>
  {% else %}
    <p class="light">No chunks indexed.</p>
  {% endfor %}
{% endblock %}
