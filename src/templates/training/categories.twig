{% extends 'interactive-ai-assistant/_layout' %}
{% import 'interactive-ai-assistant/_icons' as icons %}
{% set title = 'Training · Categories' %}
{% set selectedSubnavItem = 'training' %}
{% set tabs = {
  entries:    { label: 'Craft Entries', url: cpUrl('interactive-ai-assistant/training/entries') },
  categories: { label: 'Categories',   url: cpUrl('interactive-ai-assistant/training/categories') },
  globals:    { label: 'Globals',      url: cpUrl('interactive-ai-assistant/training/globals') },
  files:   { label: 'File Upload',   url: cpUrl('interactive-ai-assistant/training/files') },
  urls:    { label: 'URL / Sitemap', url: cpUrl('interactive-ai-assistant/training/urls') },
  qa:      { label: 'Q&A Pairs',     url: cpUrl('interactive-ai-assistant/training/qa') },
  gaps:    { label: 'Gaps',          url: cpUrl('interactive-ai-assistant/training/gaps') },
  plugins: { label: 'Plugins',       url: cpUrl('interactive-ai-assistant/training/sources') },
  transfer: { label: 'Transfer',     url: cpUrl('interactive-ai-assistant/training/transfer') },
} %}
{% set selectedTab = 'categories' %}

{% block content %}
  <form method="post" accept-charset="UTF-8" class="iaa-cards">
    {{ csrfInput() }}
    {{ actionInput('interactive-ai-assistant/training/train-category-groups') }}
    <div class="iaa-card iaa-card--wide">
      <div class="iaa-card__head">
        <span class="iaa-card__icon">{{ icons.svg('tags') }}</span>
        <h2 class="iaa-card__title">Category groups to train</h2>
      </div>
      <div class="iaa-card__body">
        {% if groups|length %}
          <ul class="iaa-checklist">
            {% for g in groups %}
              <li>
                <label>
                  <input type="checkbox" name="groups[]" value="{{ g.uid }}"
                    {% if g.uid in selectedGroups %}checked{% endif %}>
                  {{ g.name }}
                </label>
              </li>
            {% endfor %}
          </ul>
        {% else %}
          <p class="light">No category groups exist yet.</p>
        {% endif %}
      </div>
      <div class="iaa-card__foot">
        <button type="submit" class="btn submit"{% if not groups|length %} disabled{% endif %}>Train now</button>
      </div>
    </div>
  </form>

  <div class="iaa-cards">
    <div class="iaa-card iaa-card--wide">
      <div class="iaa-card__head">
        <span class="iaa-card__icon">{{ icons.svg('tags') }}</span>
        <h2 class="iaa-card__title">Indexed categories</h2>
        {% if rows|length %}<span class="iaa-card__aside"><span class="iaa-chip">{{ rows|length }}</span></span>{% endif %}
      </div>
      {% if rows|length %}
        <div class="iaa-card__body iaa-card__body--flush iaa-scroll">
          <table class="data fullwidth">
            <thead>
              <tr>
                <th>Category</th><th>Status</th><th class="iaa-num">Chunks</th><th>Last trained</th><th></th>
              </tr>
            </thead>
            <tbody>
              {% for r in rows %}
                <tr>
                  <td>
                    <a href="{{ url('interactive-ai-assistant/training/category-chunks/' ~ r.id) }}">
                      {{ titles[r.categoryId] ?? 'Category #' ~ r.categoryId }}
                    </a>
                  </td>
                  <td>{% include 'interactive-ai-assistant/training/_status' with { status: r.status } only %}</td>
                  <td class="iaa-num">{{ r.chunkCount }}</td>
                  <td class="iaa-nowrap">{{ r.lastTrainedAt ?: '—' }}</td>
                  <td>
                    <div class="iaa-row-actions">
                      <button class="btn small js-train" data-id="{{ r.id }}">Re-train</button>
                      <button class="btn small js-delete" data-id="{{ r.id }}">Delete</button>
                    </div>
                  </td>
                </tr>
              {% endfor %}
            </tbody>
          </table>
        </div>
      {% else %}
        <div class="iaa-empty"><p>No categories trained yet.</p></div>
      {% endif %}
    </div>
  </div>

  <script>
    (function(){
      function post(action, id) {
        var data = new FormData();
        data.append(Craft.csrfTokenName, Craft.csrfTokenValue);
        data.append('id', id);
        return fetch(Craft.getActionUrl(action), {method:'POST', body:data, credentials:'same-origin'}).then(function(r){return r.json();});
      }
      document.querySelectorAll('.js-train').forEach(function(b){
        b.addEventListener('click', function(){ post('interactive-ai-assistant/training/train-category', b.dataset.id).then(function(){ location.reload(); }); });
      });
      document.querySelectorAll('.js-delete').forEach(function(b){
        b.addEventListener('click', function(){
          if (!confirm('Remove this category from index?')) return;
          post('interactive-ai-assistant/training/delete-category', b.dataset.id).then(function(){ location.reload(); });
        });
      });
    })();
  </script>
{% endblock %}
