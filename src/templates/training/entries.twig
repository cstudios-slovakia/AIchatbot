{% extends 'interactive-ai-assistant/_layout' %}
{% import 'interactive-ai-assistant/_icons' as icons %}
{% set title = 'Training · Entries' %}
{% set selectedSubnavItem = 'training' %}
{% set tabs = {
  entries:    { label: 'Craft Entries', url: cpUrl('interactive-ai-assistant/training/entries') },
  categories: { label: 'Categories',   url: cpUrl('interactive-ai-assistant/training/categories') },
  globals:    { label: 'Globals',      url: cpUrl('interactive-ai-assistant/training/globals') },
  files:   { label: 'File Upload',   url: cpUrl('interactive-ai-assistant/training/files') },
  urls:    { label: 'URL / Sitemap', url: cpUrl('interactive-ai-assistant/training/urls') },
  qa:      { label: 'Q&A Pairs',     url: cpUrl('interactive-ai-assistant/training/qa') },
  gaps:    { label: 'Gaps',          url: cpUrl('interactive-ai-assistant/training/gaps') },
  plugins: { label: 'Plugins',       url: cpUrl('interactive-ai-assistant/training/sources') },
  transfer: { label: 'Transfer',     url: cpUrl('interactive-ai-assistant/training/transfer') },
} %}
{% set selectedTab = 'entries' %}

{% block content %}
  <form method="post" accept-charset="UTF-8" class="iaa-cards">
    {{ csrfInput() }}
    {{ actionInput('interactive-ai-assistant/training/train-sections') }}
    <div class="iaa-card iaa-card--wide">
      <div class="iaa-card__head">
        <span class="iaa-card__icon">{{ icons.svg('layer-group') }}</span>
        <h2 class="iaa-card__title">Sections to train</h2>
      </div>
      <div class="iaa-card__body">
        <ul class="iaa-checklist">
          {% for s in sections %}
            <li>
              <label>
                <input type="checkbox" name="sections[]" value="{{ s.uid }}"
                  {% if s.uid in selectedSections %}checked{% endif %}>
                {{ s.name }}
              </label>
            </li>
          {% endfor %}
        </ul>
      </div>
      <div class="iaa-card__foot">
        <button type="submit" class="btn submit">Train now</button>
      </div>
    </div>
  </form>

  <div class="iaa-cards">
    <div class="iaa-card iaa-card--wide">
      <div class="iaa-card__head">
        <span class="iaa-card__icon">{{ icons.svg('file-lines') }}</span>
        <h2 class="iaa-card__title">Indexed entries</h2>
        {% if rows|length %}<span class="iaa-card__aside"><span class="iaa-chip">{{ rows|length }}</span></span>{% endif %}
      </div>
      {% if rows|length %}
        <div class="iaa-card__body iaa-card__body--flush iaa-scroll">
          <table class="data fullwidth">
            <thead>
              <tr>
                <th>Entry</th><th>Status</th><th class="iaa-num">Chunks</th><th>Last trained</th><th></th>
              </tr>
            </thead>
            <tbody>
              {% for r in rows %}
                <tr>
                  <td>
                    <a href="{{ url('interactive-ai-assistant/training/entry-chunks/' ~ r.id) }}">
                      {{ entryTitles[r.entryId] ?? 'Entry #' ~ r.entryId }}
                    </a>
                  </td>
                  <td>{% include 'interactive-ai-assistant/training/_status' with { status: r.status } only %}</td>
                  <td class="iaa-num">{{ r.chunkCount }}</td>
                  <td class="iaa-nowrap">{{ r.lastTrainedAt ?: '—' }}</td>
                  <td>
                    <div class="iaa-row-actions">
                      <button class="btn small js-train-entry" data-id="{{ r.id }}">Re-train</button>
                      <button class="btn small js-delete-entry" data-id="{{ r.id }}">Delete</button>
                    </div>
                  </td>
                </tr>
              {% endfor %}
            </tbody>
          </table>
        </div>
      {% else %}
        <div class="iaa-empty"><p>No entries trained yet.</p></div>
      {% endif %}
    </div>
  </div>

  <script>
    (function(){
      function post(action, id) {
        var data = new FormData();
        data.append(Craft.csrfTokenName, Craft.csrfTokenValue);
        data.append('id', id);
        return fetch(Craft.getActionUrl(action), {method:'POST', body:data, credentials:'same-origin'})
          .then(function(r){ return r.json(); });
      }
      document.querySelectorAll('.js-train-entry').forEach(function(b){
        b.addEventListener('click', function(){
          post('interactive-ai-assistant/training/train-entry', b.dataset.id).then(function(){ location.reload(); });
        });
      });
      document.querySelectorAll('.js-delete-entry').forEach(function(b){
        b.addEventListener('click', function(){
          if (!confirm('Remove this entry from index?')) return;
          post('interactive-ai-assistant/training/delete-entry', b.dataset.id).then(function(){ location.reload(); });
        });
      });
    })();
  </script>
{% endblock %}
