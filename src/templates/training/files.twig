{% extends 'interactive-ai-assistant/_layout' %}
{% set title = 'Training · Files' %}
{% set selectedSubnavItem = 'training' %}
{% set tabs = {
  entries:    { label: 'Craft Entries', url: cpUrl('interactive-ai-assistant/training/entries') },
  categories: { label: 'Categories',   url: cpUrl('interactive-ai-assistant/training/categories') },
  globals:    { label: 'Globals',      url: cpUrl('interactive-ai-assistant/training/globals') },
  files:   { label: 'File Upload',   url: cpUrl('interactive-ai-assistant/training/files') },
  urls:    { label: 'URL / Sitemap', url: cpUrl('interactive-ai-assistant/training/urls') },
  qa:      { label: 'Q&A Pairs',     url: cpUrl('interactive-ai-assistant/training/qa') },
  gaps:    { label: 'Gaps',          url: cpUrl('interactive-ai-assistant/training/gaps') },
  plugins: { label: 'Plugins',       url: cpUrl('interactive-ai-assistant/training/sources') },
  transfer: { label: 'Transfer',     url: cpUrl('interactive-ai-assistant/training/transfer') },
} %}
{% set selectedTab = 'files' %}

{% block content %}
  <div id="chatbot-drop" style="border:2px dashed #c9d3dc;border-radius:8px;padding:24px;text-align:center;margin-bottom:16px;background:#fafbfc;">
    <p><strong>Drop .txt, .md, .pdf or .docx files here</strong> or
      <button class="btn submit" id="chatbot-file-pick">Browse</button></p>
    <p class="light" style="font-size:12px;">Max {{ (maxUploadBytes / 1024 / 1024)|number_format(1) }} MB each. Scanned PDFs need OCR first — there is no text in them to read.</p>
    <input type="file" id="chatbot-file-input" accept=".txt,.md,.pdf,.docx" multiple style="display:none;">
    {% if sites|length > 1 %}
      <div style="margin-top:10px;">
        <label>Applies to
          <span class="select">
            <select id="chatbot-file-site">
              <option value="0">All sites</option>
              {% for site in sites %}
                <option value="{{ site.id }}">{{ site.name }} ({{ site.language }})</option>
              {% endfor %}
            </select>
          </span>
        </label>
      </div>
    {% endif %}
    <div id="chatbot-upload-status" style="margin-top:8px;color:#596673;"></div>
    <div id="chatbot-upload-errors" style="margin-top:8px;text-align:left;display:none;"></div>
  </div>

  <h2>Files</h2>
  {% if rows|length %}
    <table class="data fullwidth">
      {% set siteNames = {} %}
      {% for site in sites %}{% set siteNames = siteNames|merge({ (site.id): site.name }) %}{% endfor %}
      <thead><tr><th>Name</th>{% if sites|length > 1 %}<th>Applies to</th>{% endif %}<th>Status</th><th>Chunks</th><th>Size</th><th>Last indexed</th><th></th></tr></thead>
      <tbody>
        {% for r in rows %}
          <tr>
            <td>{{ r.originalName }}</td>
            {% if sites|length > 1 %}<td>{{ r.siteId ? (siteNames[r.siteId] ?? 'Site #' ~ r.siteId) : 'All sites' }}</td>{% endif %}
            <td><span class="status-pill status-{{ r.status }}">{{ r.status }}</span></td>
            <td>{{ r.chunkCount }}</td>
            <td>{{ (r.size / 1024)|number_format(1) }} KB</td>
            <td>{{ r.lastTrainedAt ?: '—' }}</td>
            <td>
              <button class="btn small js-reindex" data-id="{{ r.id }}">Re-index</button>
              <button class="btn small js-delete" data-id="{{ r.id }}">Delete</button>
            </td>
          </tr>
        {% endfor %}
      </tbody>
    </table>
  {% else %}
    <p class="light">No files uploaded yet.</p>
  {% endif %}

  <script>
    (function(){
      var drop = document.getElementById('chatbot-drop');
      var input = document.getElementById('chatbot-file-input');
      var pick = document.getElementById('chatbot-file-pick');
      var status = document.getElementById('chatbot-upload-status');
      var errorBox = document.getElementById('chatbot-upload-errors');
      var maxBytes = {{ maxUploadBytes }};

      function human(bytes) {
        return bytes >= 1048576
          ? (Math.round(bytes / 104857.6) / 10) + ' MB'
          : Math.max(1, Math.round(bytes / 1024)) + ' KB';
      }

      // Errors stay on the page until the next upload run replaces them.
      // Nothing here reloads while one is showing: a reload is what used to
      // wipe the message before it could be read.
      function showErrors(failures) {
        errorBox.innerHTML = '';
        if (!failures.length) { errorBox.style.display = 'none'; return; }
        var list = document.createElement('ul');
        list.className = 'errors';
        list.style.margin = '0';
        failures.forEach(function (f) {
          var item = document.createElement('li');
          item.textContent = f;
          list.appendChild(item);
        });
        errorBox.appendChild(list);
        errorBox.style.display = '';
      }

      pick.addEventListener('click', function(e){ e.preventDefault(); input.click(); });
      input.addEventListener('change', function(){ upload(input.files); });
      ['dragover','dragenter'].forEach(function(ev){ drop.addEventListener(ev, function(e){ e.preventDefault(); drop.style.background = '#eef2ff'; }); });
      ['dragleave','drop'].forEach(function(ev){ drop.addEventListener(ev, function(e){ e.preventDefault(); drop.style.background = '#fafbfc'; }); });
      drop.addEventListener('drop', function(e){ upload(e.dataTransfer.files); });

      function upload(files){
        if (!files || !files.length) return;
        var queue = Array.from(files);
        var total = queue.length;
        var uploaded = 0;
        var failures = [];
        showErrors([]);

        function done(){
          if (!failures.length) {
            // Everything landed — reload so the new rows and their training
            // status appear.
            location.reload();
            return;
          }
          status.textContent = uploaded
            ? (uploaded + ' of ' + total + ' uploaded. The rest failed:')
            : (total === 1 ? 'Upload failed:' : 'All ' + total + ' uploads failed:');
          showErrors(failures);
          if (uploaded) {
            var refresh = document.createElement('p');
            refresh.style.margin = '8px 0 0';
            var link = document.createElement('a');
            link.href = window.location.href;
            link.className = 'btn small';
            link.textContent = 'Refresh the list';
            refresh.appendChild(link);
            errorBox.appendChild(refresh);
          }
          // The same file can be re-picked after a failure only if the input
          // is cleared; the change event does not fire for an identical value.
          input.value = '';
        }

        function next(){
          if (!queue.length) { done(); return; }
          var f = queue.shift();
          status.textContent = 'Uploading ' + f.name + '…';

          // Checked here as well as on the server, so an oversized file fails
          // instantly instead of after a long upload the server then discards
          // — and so a body over post_max_size never reaches PHP at all.
          if (f.size > maxBytes) {
            failures.push(f.name + ' is ' + human(f.size) + '. The limit is ' + human(maxBytes) + ' per file.');
            next();
            return;
          }

          var data = new FormData();
          data.append(Craft.csrfTokenName, Craft.csrfTokenValue);
          data.append('file', f);
          var siteSelect = document.getElementById('chatbot-file-site');
          data.append('siteId', siteSelect ? siteSelect.value : 0);
          fetch(Craft.getActionUrl('interactive-ai-assistant/training/upload-file'), {method:'POST', body:data, credentials:'same-origin'})
            .then(function(r){
              // A web server that rejects the body itself (413) answers with
              // HTML, and so does a PHP fatal — r.json() would throw and the
              // queue would stall on "Uploading…" forever.
              return r.text().then(function(body){
                var parsed = null;
                try { parsed = JSON.parse(body); } catch (e) { /* not JSON */ }
                if (parsed) { return parsed; }
                if (r.status === 413) {
                  return { success: false, error: 'The web server rejected ' + f.name + ' as too large (413). Raise client_max_body_size / LimitRequestBody, or upload a smaller file.' };
                }
                return { success: false, error: 'The server answered ' + r.status + ' with something that is not JSON.' };
              });
            })
            .then(function(j){
              if (j.success) { uploaded++; } else { failures.push(j.error || (f.name + ': unknown error')); }
              next();
            })
            .catch(function(err){
              failures.push(f.name + ': ' + (err && err.message ? err.message : 'the request failed'));
              next();
            });
        }
        next();
      }

      function post(action, id){
        var data = new FormData();
        data.append(Craft.csrfTokenName, Craft.csrfTokenValue);
        data.append('id', id);
        return fetch(Craft.getActionUrl(action), {method:'POST', body:data, credentials:'same-origin'}).then(function(r){return r.json();});
      }
      document.querySelectorAll('.js-reindex').forEach(function(b){ b.addEventListener('click', function(){ post('interactive-ai-assistant/training/reindex-file', b.dataset.id).then(function(){ location.reload(); }); }); });
      document.querySelectorAll('.js-delete').forEach(function(b){ b.addEventListener('click', function(){ if(!confirm('Delete?'))return; post('interactive-ai-assistant/training/delete-file', b.dataset.id).then(function(){ location.reload(); }); }); });
    })();
  </script>
{% endblock %}
