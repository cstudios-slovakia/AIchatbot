{% extends 'interactive-ai-assistant/_layout' %}
{% import 'interactive-ai-assistant/_icons' as icons %}
{% set title = 'Training · Transfer' %}
{% set selectedSubnavItem = 'training' %}
{% set tabs = {
  entries:    { label: 'Craft Entries', url: cpUrl('interactive-ai-assistant/training/entries') },
  categories: { label: 'Categories',   url: cpUrl('interactive-ai-assistant/training/categories') },
  globals:    { label: 'Globals',      url: cpUrl('interactive-ai-assistant/training/globals') },
  files:   { label: 'File Upload',   url: cpUrl('interactive-ai-assistant/training/files') },
  urls:    { label: 'URL / Sitemap', url: cpUrl('interactive-ai-assistant/training/urls') },
  qa:      { label: 'Q&A Pairs',     url: cpUrl('interactive-ai-assistant/training/qa') },
  gaps:    { label: 'Gaps',          url: cpUrl('interactive-ai-assistant/training/gaps') },
  plugins: { label: 'Plugins',       url: cpUrl('interactive-ai-assistant/training/sources') },
  transfer: { label: 'Transfer',     url: cpUrl('interactive-ai-assistant/training/transfer') },
} %}
{% set selectedTab = 'transfer' %}

{% set kinds = {
  entries:    'Craft entries',
  categories: 'Categories',
  globals:    'Global sets',
  files:      'Uploaded documents',
  urls:       'Crawled URLs',
  qa:         'Q&A pairs',
  sources:    'Plugin sources',
  forms:      'Conversational forms',
} %}

{% block content %}
  <div class="iaa-note iaa-note--info">
    <span class="iaa-note__icon">{{ icons.svg('circle-info') }}</span>
    <p>
      Train on a copy of the site where a bad crawl costs nothing, then carry the
      finished index here instead of paying for every embedding twice and waiting
      out the queue on a site that is already serving visitors.
    </p>
  </div>

  <div class="iaa-cards iaa-cards--stretch">

    <form method="post" accept-charset="UTF-8" class="iaa-card">
      {{ csrfInput() }}
      {{ actionInput('interactive-ai-assistant/training/export-bundle') }}
      {{ redirectInput('interactive-ai-assistant/training/transfer') }}
      <div class="iaa-card__head">
        <span class="iaa-card__icon">{{ icons.svg('download') }}</span>
        <h2 class="iaa-card__title">Export</h2>
      </div>
      <div class="iaa-card__body">
        <p class="iaa-card__note">
          {{ chunkCount }} chunk{{ chunkCount == 1 ? '' : 's' }} embedded with
          <code>{{ embeddingModel }}</code>{% if embeddingDimensions %} at {{ embeddingDimensions }} dimensions{% endif %}.
        </p>

        <div class="field">
          <div class="heading"><label>What to include</label></div>
          <div class="input">
            {# so clearing every box means "nothing", not "everything" #}
            <input type="hidden" name="kinds[]" value="">
            <ul class="iaa-checklist">
              {% for kind, label in kinds %}
                <li{{ counts[kind] ? '' : ' class="iaa-dim"' }}>
                  <label>
                    <input type="checkbox" name="kinds[]" value="{{ kind }}" checked>
                    {{ label }} <span class="light">({{ counts[kind] }})</span>
                  </label>
                </li>
              {% endfor %}
            </ul>
          </div>
        </div>

        <div class="field">
          <label class="iaa-check">
            <input type="checkbox" name="includeFiles" value="1" checked>
            Include the uploaded document files
          </label>
        </div>

        <div class="iaa-note iaa-note--warn iaa-note--tight">
          <span class="iaa-note__icon">{{ icons.svg('shield-halved') }}</span>
          <p>
            Form definitions travel with their delivery config. A webhook header
            typed in literally rather than as <code>$ENV_VAR</code> is in the bundle
            in the clear — keep it out of version control.
          </p>
        </div>
      </div>
      <div class="iaa-card__foot">
        <button type="submit" class="btn submit">Download bundle</button>
        <span class="light">
          A gzipped <code>.ndjson.gz</code> file: every trained source, its vectors,
          the documents behind them, and the form definitions.
        </span>
      </div>
    </form>

    <form method="post" accept-charset="UTF-8" enctype="multipart/form-data" class="iaa-card">
      {{ csrfInput() }}
      {{ actionInput('interactive-ai-assistant/training/import-bundle') }}
      {{ redirectInput('interactive-ai-assistant/training/transfer') }}
      <div class="iaa-card__head">
        <span class="iaa-card__icon">{{ icons.svg('upload') }}</span>
        <h2 class="iaa-card__title">Import</h2>
      </div>
      <div class="iaa-card__body">
        <p class="iaa-card__note">
          Content is matched by element UID and site handle, never by the ids it
          had where it was trained. Anything this site does not have is reported,
          not guessed at. Forms this site already defines are kept as they are,
          and an imported form waits at admins-only until you turn it on.
        </p>

        <input type="file" name="bundle" accept=".gz,application/gzip" required>

        <div class="field">
          <div class="heading"><label>What to import</label></div>
          <div class="input">
            {# so clearing every box means "nothing", not "everything" #}
            <input type="hidden" name="kinds[]" value="">
            <ul class="iaa-checklist">
              {% for kind, label in kinds %}
                <li>
                  <label>
                    <input type="checkbox" name="kinds[]" value="{{ kind }}" checked> {{ label }}
                  </label>
                </li>
              {% endfor %}
            </ul>
          </div>
        </div>

        <div class="field">
          <ul class="iaa-checklist iaa-checklist--stack">
            <li><label><input type="checkbox" name="dryRun" value="1"> Dry run — report what would happen, write nothing</label></li>
            <li><label><input type="checkbox" name="reembed" value="1"> Re-embed here instead of reusing the bundle's vectors</label></li>
            <li><label><input type="checkbox" name="overwriteFiles" value="1"> Replace documents that already exist here</label></li>
            <li><label><input type="checkbox" name="overwriteForms" value="1"> Replace forms this site already defines under the same name</label></li>
          </ul>
        </div>

        {% if sites|length > 1 %}
          <div class="field">
            <div class="heading"><label>Site handle mapping</label></div>
            <div class="input">
              <input type="text" name="siteMap" class="text fullwidth" placeholder="sk=en, hu=de">
            </div>
            <div class="instructions"><p>
              Only needed when the two installs set their sites up under different
              handles. This site has:
              {% for site in sites %}<code>{{ site.handle }}</code>{{ not loop.last ? ', ' }}{% endfor %}.
            </p></div>
          </div>
        {% endif %}
      </div>
      <div class="iaa-card__foot">
        <button type="submit" class="btn submit">Import bundle</button>
        <span class="light">
          The bundle must come from the same embedding model this site is set to,
          or the import will say so — vectors from different models cannot be
          compared. Use <strong>re-embed</strong> to import the content and embed
          it here instead.
        </span>
      </div>
    </form>

  </div>

  <div class="iaa-cards">
    <div class="iaa-card iaa-card--wide">
      <div class="iaa-card__head">
        <span class="iaa-card__icon">{{ icons.svg('bolt') }}</span>
        <h2 class="iaa-card__title">From the shell</h2>
      </div>
      <div class="iaa-card__body">
        <p class="iaa-card__note">
          A large index moves faster over SSH than through a browser upload, and the
          console reports every source it could not place:
        </p>
<pre class="iaa-pre">php craft interactive-ai-assistant/rag/export
php craft interactive-ai-assistant/rag/import bundle.ndjson.gz --dry-run
php craft interactive-ai-assistant/rag/import bundle.ndjson.gz</pre>
      </div>
    </div>
  </div>
{% endblock %}
